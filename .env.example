# =============================================================================
# QF Network Deployment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Network Configuration
# -----------------------------------------------------------------------------

# QF Network RPC URL
# Mainnet: wss://rpc.qfnetwork.io
# Testnet: wss://rpc-testnet.qfnetwork.io
# Local: ws://localhost:9944
QF_RPC_URL=wss://rpc.qfnetwork.io

# -----------------------------------------------------------------------------
# Deployer Account
# -----------------------------------------------------------------------------

# Deployer mnemonic phrase (12 or 24 words)
# ⚠️  NEVER commit the actual mnemonic to version control!
# Get testnet funds from the QF Network faucet
DEPLOYER_MNEMONIC="word1 word2 word3 ... word12"

# -----------------------------------------------------------------------------
# Contract Compilation
# -----------------------------------------------------------------------------

# Path to compiled PolkaVM bytecode
BYTECODE_PATH=./output/QNSRegistrar.polkavm

# Path to contract ABI
ABI_PATH=./src/abi/QNSRegistrar.json

# -----------------------------------------------------------------------------
# Deployment Parameters
# -----------------------------------------------------------------------------

# Gas limit for deployment (default: 100000000000)
GAS_LIMIT=100000000000

# Initial value to send with deployment (in wei, default: 0)
DEPLOY_VALUE=0

# Constructor arguments as JSON array
# Examples:
#   No args: "[]"
#   One address: '["0x1234..."]'
#   Multiple: '["0x1234...", 100, true]'
CONSTRUCTOR_ARGS=[]

# -----------------------------------------------------------------------------
# Contract Addresses (Update after deployment)
# -----------------------------------------------------------------------------

# QNS Registrar contract address
VITE_QNS_REGISTRAR_ADDRESS=0x0000000000000000000000000000000000000000

# QNS Resolver contract address  
VITE_QNS_RESOLVER_ADDRESS=0x0000000000000000000000000000000000000000

# QNS Registry contract address
VITE_QNS_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# QNS Badge Registry contract address
VITE_QNS_BADGE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
